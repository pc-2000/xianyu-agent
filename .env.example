# Copy to .env and fill in. Never commit the real .env.

# Python admin (required in production compose)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET_KEY=

# Bridge token shared by Python and the OpenClaw plugin
BRIDGE_TOKEN=

# Optional model keys used by OpenClaw (also can live in mounted openclaw.json)
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Feishu — rotate if this secret was ever pasted in chat
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
